# Copy to .env and fill in values
# These defaults assume a self-hosted Supabase stack from the official docker-compose running on localhost

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Postgres (self-hosted Supabase, DIRECT connection — port 5433 via docker-compose.override.yml)
# Port 5432 is taken by Supavisor (pooler). Drizzle needs a direct connection for DDL/migrations.
DATABASE_URL=postgres://postgres:your-super-secret-and-long-postgres-password@localhost:5433/postgres

# Supabase Auth (GoTrue) — MUST match the JWT_SECRET used by Supabase
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Base URL of the web app, used to build Discord /link flow URLs.
# Schema default is http://localhost:3000, but in this repo's dev setup the web app runs on 3001.
WEB_APP_URL=http://localhost:3001
